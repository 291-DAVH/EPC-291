{
  "schema_version": "1.0",
  "limits": {"max_input_mb": 25, "max_lines": 2000, "max_nodes": 2000, "max_points_per_line": 500},
  "geometry": {"snap_tolerance_m": 0.15, "min_scale_distance_m": 0.01, "min_calibration_units": 1e-6},
  "levels": {"pattern": "^L(0|[1-9][0-9]*|-[1-9][0-9]*)$", "ground": "L0"},
  "tags": {"junction_prefix": "J", "end_prefix": "E", "digits": 3, "stretch_separator": "/"},
  "dxf": {"default_version": "R2018", "versions": ["R2000", "R2004", "R2007", "R2010", "R2013", "R2018"], "text_height_m": 0.25, "node_symbol_size_m": 0.6,
          "tag_layer": "PLAN-TAG", "junction_layer": "PLAN-NODO", "default_units": "m"},
  "style": {"line_width_mm": 0.25, "font_size_mm": 2.0, "colors": {"line": "#000000", "highlight": "#d62728"}}
}
