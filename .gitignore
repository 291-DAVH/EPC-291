# ===== Private / never versioned =====
# local/ holds dev-knowledge (standards, third-party reports, study material), legacy (archived folders and
# old repositories), projects-demo (simulated data) and projects (real client projects, each in its own repo)
/local/
_study/

# ===== Copyrighted / CAD binaries =====
*.pdf
*.dwg
*.dwl
*.dwl2
!docs/**/*.pdf
# study material and standards live only in /local/ (see docs/explanation/knowledge.md); knowledge extracted by Claude ships with the engine

# ===== Local environment and build output =====
.venv/
node_modules/
dist/
build/
# tools/build holds the build scripts, not build output
!tools/build/
# the project skeleton keeps its (empty) build folders
!management/templates/**/build/
__pycache__/
*.pyc
*.plugin
.env
.env.*
!.env.example
.claude/*
!.claude/README.md
_out/
*.bak
*.tmp
Thumbs.db
*.egg-info/
