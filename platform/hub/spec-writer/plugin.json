{
  "id": "spec-writer",
  "version": "0.1.0",
  "kind": "workflow",
  "description": "Technical specification (PG/ET) writer for any engineering discipline, backed by the Document Writer agent. Reference material lives in dev-knowledge, never in this repo.",
  "discipline": [
    "all"
  ],
  "requires": {
    "doc-quality": "^0.1.0"
  },
  "consumes": [
    "Requirement",
    "Parameter"
  ],
  "produces": [
    "Document:PG",
    "Document:ET"
  ],
  "outputs": [
    {
      "format": "md",
      "channel": "internal"
    },
    {
      "format": "docx",
      "channel": "internal+deliverable"
    },
    {
      "format": "pdf",
      "channel": "internal+deliverable"
    }
  ],
  "entitlement": "feature.specs",
  "python": {
    "requires": []
  },
  "skills": [
    {
      "id": "generate-specification",
      "role": "owner"
    }
  ],
  "agents": [
    "document-writer"
  ],
  "status": "needs-neutral-templates",
  "note": "Discipline block templates were learned from client documents and are kept in dev-knowledge/skill-knowledge/generate-specification until rewritten neutrally.",
  "legacy": {
    "source": "00-Template-Claude/.claude/skills/generar-pliego"
  }
}
