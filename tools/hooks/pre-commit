#!/bin/sh
# Repository safety hook. Enable with:  git config core.hooksPath tools/hooks
#  1. No direct commits on main or dev (merge from feature/* or fix/*). Override: ALLOW_PROTECTED=1
#  2. No PDF/DWG (copyright / CAD binaries) and nothing from local/ (dev-knowledge, legacy, demo and client projects)
#  3. No file larger than 5 MB
#  4. No .env files (only .env.example) and no obvious secrets (private keys, GitHub/AWS tokens) in added lines

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$ALLOW_PROTECTED" ] && { [ "$branch" = "main" ] || [ "$branch" = "dev" ]; }; then
  echo "COMMIT BLOCKED: do not commit directly on '$branch'. Create a branch: git switch -c feature/<topic>"
  echo "(see docs/BRANCHING.md; override only for the baseline or a hotfix with ALLOW_PROTECTED=1)"
  exit 1
fi

bad=$(git diff --cached --name-only --diff-filter=AM | grep -Ei '\.(pdf|dwg)$' | grep -Ev '^docs/')
if [ -n "$bad" ]; then
  echo "COMMIT BLOCKED: PDF/DWG files are not allowed in the repository:"
  echo "$bad"
  echo "Study material belongs in local/dev-knowledge/ (never versioned)."
  exit 1
fi

private=$(git diff --cached --name-only --diff-filter=AM | grep -E '^local/')
if [ -n "$private" ]; then
  echo "COMMIT BLOCKED: private folders must never be committed:"
  echo "$private"
  exit 1
fi

envs=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)\.env(\.[^/]*)?$' | grep -Ev '\.env\.example$')
if [ -n "$envs" ]; then
  echo "COMMIT BLOCKED: environment files can hold secrets (only .env.example is allowed):"
  echo "$envs"
  exit 1
fi

secrets=$(git diff --cached -U0 --diff-filter=AM | grep -E '^\+' | grep -E 'BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{40,}|AKIA[0-9A-Z]{16}' | head -3)
if [ -n "$secrets" ]; then
  echo "COMMIT BLOCKED: something that looks like a secret is being added (private key or access token)."
  exit 1
fi

big=$(git diff --cached --name-only --diff-filter=AM | while read f; do [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 5000000 ] && echo "$f"; done)
if [ -n "$big" ]; then
  echo "COMMIT BLOCKED: files larger than 5 MB:"; echo "$big"; exit 1
fi
exit 0
