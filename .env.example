# Copy to .env.demo / .env.admin (git-ignored) and adjust the paths
EPC_PROJECTS=./projects-demo
EPC_ROLE=user            # user | admin
EPC_USER=
ANTHROPIC_API_KEY=       # optional: enables the automatic analysis of customer input (server side, never in the repository)
EPC_ANALYSIS_MODEL=      # default claude-sonnet-5-5
EPC_ORG=
EPC_AUTH=simulated       # simulated (role from EPC_ROLE, no login) | required (accounts and sessions; the default when EPC_ENV=production)
EPC_SIGNUP=closed        # open: anyone may create an individual or company account; closed: by invitation or by the staff
EPC_DATABASE_URL=        # accounts database; empty = SQLite file local/epc.db
EPC_CONSOLE_URL=http://localhost:5174    # technical console address (link shown to the engineering team)
EPC_PUBLIC_URL=http://localhost:5173    # customer app address, used in invitation links and as the return address of the sign-in with providers
EPC_SECRET_KEY=                          # long random text; signs the short cookies of the sign-in with providers (set it in production)
# Sign-in and sign-up with Google, GitHub, Facebook, LinkedIn: a provider shows up only when both values are set (docs/oauth-providers.md)
EPC_OAUTH_GOOGLE_CLIENT_ID=
EPC_OAUTH_GOOGLE_CLIENT_SECRET=
EPC_OAUTH_GITHUB_CLIENT_ID=
EPC_OAUTH_GITHUB_CLIENT_SECRET=
EPC_OAUTH_FACEBOOK_CLIENT_ID=
EPC_OAUTH_FACEBOOK_CLIENT_SECRET=
EPC_OAUTH_LINKEDIN_CLIENT_ID=
EPC_OAUTH_LINKEDIN_CLIENT_SECRET=
EPC_DATA=./data         # company profile, clients, people and logos (default: local/data)
