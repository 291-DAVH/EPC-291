# Copy to .env.demo / .env.admin (git-ignored) and adjust the paths
EPC_PROJECTS=./projects-demo
EPC_ROLE=user            # user | admin
EPC_USER=
ANTHROPIC_API_KEY=       # optional: enables the automatic analysis of customer input (server side, never in the repository)
EPC_ANALYSIS_MODEL=      # default claude-sonnet-5-5
EPC_ORG=
EPC_DATA=./data         # company profile, clients, people and logos (default: local/data)
