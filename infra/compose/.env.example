# Copy to infra/compose/.env (git-ignored) and set real values
POSTGRES_USER=epc
POSTGRES_PASSWORD=
POSTGRES_DB=epc
EPC_ROLE=user            # user | admin (admin unlocks the API for the console)
EPC_USER=
ANTHROPIC_API_KEY=       # optional: automatic analysis of customer input
EPC_ORG=
EPC_AUTH=required       # accounts and sessions (EPC_ROLE is ignored); simulated = role from EPC_ROLE, for a private demo only
EPC_SIGNUP=closed        # open: anyone may create an account
EPC_PUBLIC_URL=http://localhost:8080    # customer app address, used in invitation links
EPC_COOKIE_SECURE=       # 1 when served over HTTPS
