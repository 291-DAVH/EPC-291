{
  "id": "board-design",
  "version": "0.1.0",
  "kind": "workflow",
  "description": "Designs a low-voltage board end to end: the project's design criteria govern the circuit calculation (epc_calc) and that calculation feeds the single-line (SLD) and multi-line (MLD) diagrams on IRAM sheets (SVG, DXF, PDF).",
  "discipline": [
    "electrical"
  ],
  "jurisdiction": [
    "AR"
  ],
  "requires": {
    "aea-calc": "^1.6.0",
    "sld": "^0.1.2",
    "mld": "^0.2.0",
    "iec-symbols": "^0.4.14",
    "iram-titleblock": "^0.5.1"
  },
  "consumes": [
    "DesignCriteria",
    "Board",
    "Circuit"
  ],
  "produces": [
    "CircuitCalculation",
    "Drawing:SLD",
    "Drawing:MLD"
  ],
  "outputs": [
    {
      "format": "json",
      "channel": "internal"
    },
    {
      "format": "svg",
      "channel": "internal"
    },
    {
      "format": "dxf",
      "channel": "internal+deliverable"
    },
    {
      "format": "pdf",
      "channel": "internal+deliverable"
    }
  ],
  "entitlement": "feature.design.board",
  "python": {
    "requires": [
      "openpyxl>=3.1",
      "lxml",
      "ezdxf",
      "svgelements",
      "shapely",
      "matplotlib"
    ]
  },
  "skills": [
    {
      "id": "design-board",
      "role": "owner"
    }
  ],
  "engine": [
    "calc",
    "drawing"
  ]
}
