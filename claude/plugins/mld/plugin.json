{
  "id": "mld",
  "version": "0.2.2",
  "kind": "generator",
  "description": "Multi-line diagram (MLD) of a board from the same data and calculation as the single-line: each line is expanded into its conductors (L1 L2 L3 N) with the MLD_LV symbols, on IRAM sheets (SVG and DXF; the PDF is rendered by the exporter).",
  "discipline": [
    "electrical"
  ],
  "requires": {
    "aea-calc": "^1.6.0",
    "sld": "^0.1.2",
    "iram-titleblock": "^0.5.1",
    "iec-symbols": "^0.4.14"
  },
  "consumes": [
    "CircuitCalculation",
    "Board",
    "Circuit"
  ],
  "produces": [
    "Drawing:MLD"
  ],
  "outputs": [
    {
      "format": "svg",
      "channel": "internal"
    },
    {
      "format": "dxf",
      "channel": "internal+deliverable"
    }
  ],
  "entitlement": "feature.drawing.mld",
  "python": {
    "requires": [
      "openpyxl>=3.1",
      "lxml",
      "ezdxf",
      "svgelements",
      "shapely",
      "matplotlib"
    ]
  },
  "skills": [
    {
      "id": "convert-sld-to-mld",
      "role": "owner"
    }
  ],
  "legacy": {
    "name": "mld-generator",
    "source": "mld-generator"
  },
  "engine": [
    "calc",
    "drawing"
  ]
}
