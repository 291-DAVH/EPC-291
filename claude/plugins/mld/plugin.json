{
  "id": "mld",
  "version": "0.2.2",
  "kind": "generator",
  "description": "Multi-line diagram (MLD) of a board from the same data and calculation as the single-line: each line is expanded into its conductors (L1 L2 L3 N) with the MLD_LV symbols, on IRAM sheets (SVG and DXF; the PDF is rendered by the exporter).",
  "discipline": [
    "electrical"
  ],
  "requires": {
    "aea-calc": "^1.8.0",
    "dxf-output": "^0.1.0",
    "iec-symbols": "^0.4.19",
    "iram-titleblock": "^0.5.4"
  },
  "consumes": [
    "CircuitCalculation",
    "Board",
    "Circuit"
  ],
  "produces": [
    "Drawing:MLD"
  ],
  "outputs": [
    {
      "format": "svg",
      "channel": "internal"
    },
    {
      "format": "dxf",
      "channel": "internal+deliverable"
    }
  ],
  "entitlement": "feature.drawing.mld",
  "python": {
    "requires": [
      "ezdxf",
      "lxml",
      "openpyxl",
      "shapely",
      "svgelements",
      "vtracer"
    ]
  },
  "skills": [],
  "legacy": {
    "name": "mld-generator",
    "source": "mld-generator"
  },
  "engine": [
    "calc",
    "dxf",
    "mld",
    "symbols",
    "titleblock"
  ],
  "owns": [
    "mld"
  ]
}
