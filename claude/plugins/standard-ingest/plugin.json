{
  "id": "standard-ingest",
  "version": "0.1.0",
  "kind": "workflow",
  "description": "Turns standards (PDFs kept in local/dev-knowledge) into validated rules.json files per standard: text extraction, page rendering for scanned standards, validation (schema, verbatim-copy guard, clause check) and promotion to jurisdictions/. Code: engine/standards; works with the rules engine in engine/rules.",
  "discipline": [
    "all"
  ],
  "jurisdiction": [
    "AR",
    "INTL"
  ],
  "requires": {
    "aea-calc": "^1.8.0"
  },
  "consumes": [
    "StandardPdf"
  ],
  "produces": [
    "Rules"
  ],
  "outputs": [
    {
      "format": "json",
      "channel": "internal"
    }
  ],
  "entitlement": "feature.rules.ingest",
  "python": {
    "requires": [
      "jsonschema",
      "openpyxl",
      "pypdf",
      "pypdfium2"
    ],
    "optional": [
      "jsonschema"
    ]
  },
  "skills": [
    {
      "id": "analyze-standard",
      "role": "owner"
    }
  ],
  "engine": [
    "calc",
    "rules",
    "standards"
  ],
  "legacy": {
    "source": "engine/calc/src/epc_calc/rules (177 rules imported by epc_standards.import_legacy_rules)"
  },
  "owns": [
    "standards",
    "rules"
  ]
}
